{
	"name": "EmbeddableContent",
	"version": "0.2.0",
	"author": [
		"ronzz.org"
	],
	"url": "https://github.com/Ron-RONZZ-org/ronzz-wikibase",
	"descriptionmsg": "embeddablecontent-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"AutoloadNamespaces": {
		"EmbeddableContent\\": "includes/"
	},
	"MessagesDirs": {
		"EmbeddableContent": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"EmbeddableContentMagic": "i18n/EmbeddableContent.i18n.magic.php"
	},
	"config": {
		"EmbeddableContentConfig": {
			"value": [],
			"description": "Instance-specific config map emitted by the seed (issue #6 D2 + issue #7): instanceOf, classes, agentClasses, sourceClasses, payloadProperties, programmingLanguage, provenance, externalIds, citationMetadata, formatterUrl, sourceClassByWikidata, agentClassByWikidata, fallbackLanguages, lexers."
		}
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"SpecialPages": {
		"Embed": {
			"class": "EmbeddableContent\\Spec\\SpecialEmbed",
			"services": [
				"EmbeddableContent.ContentRenderer"
			]
		},
		"AddQuotation": {
			"class": "EmbeddableContent\\Spec\\SpecialAddQuotation"
		},
		"AddCodeSnippet": {
			"class": "EmbeddableContent\\Spec\\SpecialAddCodeSnippet"
		},
		"AddMath": {
			"class": "EmbeddableContent\\Spec\\SpecialAddMath"
		},
		"AddPerson": {
			"class": "EmbeddableContent\\Spec\\SpecialAddPerson",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"AddSource": {
			"class": "EmbeddableContent\\Spec\\SpecialAddSource",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"AddCollective": {
			"class": "EmbeddableContent\\Spec\\SpecialAddCollective",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"AddFictionalCharacter": {
			"class": "EmbeddableContent\\Spec\\SpecialAddFictionalCharacter",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"AddSoftware": {
			"class": "EmbeddableContent\\Spec\\SpecialAddSoftware",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"UpdatePerson": {
			"class": "EmbeddableContent\\Spec\\SpecialUpdatePerson",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"UpdateSource": {
			"class": "EmbeddableContent\\Spec\\SpecialUpdateSource",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"UpdateCollective": {
			"class": "EmbeddableContent\\Spec\\SpecialUpdateCollective",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"UpdateSoftware": {
			"class": "EmbeddableContent\\Spec\\SpecialUpdateSoftware",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"UpdateFictionalCharacter": {
			"class": "EmbeddableContent\\Spec\\SpecialUpdateFictionalCharacter",
			"services": [
				"EmbeddableContent.Config",
				"EmbeddableContent.ProviderClient"
			]
		},
		"SourceFile": {
			"class": "EmbeddableContent\\Spec\\SpecialSourceFile",
			"services": [
				"EmbeddableContent.Config"
			]
		}
	},
	"APIModules": {
		"embed": {
			"class": "EmbeddableContent\\Api\\ApiEmbed",
			"services": [
				"EmbeddableContent.ContentRenderer"
			]
		},
		"uploadmeta": {
			"class": "EmbeddableContent\\Api\\ApiUploadMeta"
		}
	},
	"HookHandlers": {
		"main": {
			"class": "EmbeddableContent\\Hooks"
		},
		"upload": {
			"class": "EmbeddableContent\\Upload\\UploadHooks"
		}
	},
	"Hooks": {
		"BeforePageDisplay": "main",
		"SkinTemplateNavigation::Universal": "main",
		"ParserFirstCallInit": "main",
		"UploadFormInitDescriptor": "upload",
		"UploadFormSourceDescriptors": "upload",
		"UploadForm:getInitialPageText": "upload",
		"UploadComplete": "upload"
	},
	"ResourceModules": {
		"ext.embeddableContent.embed": {
			"styles": [
				"embed.css"
			],
			"scripts": [
				"math.js",
				"code.js"
			],
			"targets": [
				"desktop",
				"mobile"
			],
			"dependencies": [
				"ext.embeddableContent.katex",
				"ext.embeddableContent.highlight"
			]
		},
		"ext.embeddableContent.entitysuggest": {
			"scripts": [
				"entitysuggest.js"
			],
			"dependencies": [
				"mediawiki.api",
				"oojs-ui"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.addmath": {
			"scripts": [
				"addmath.js"
			],
			"styles": [
				"embed.css"
			],
			"dependencies": [
				"ext.embeddableContent.katex",
				"oojs-ui"
			],
			"messages": [
				"embeddablecontent-add-math-preview"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.gadget": {
			"scripts": [
				"gadget.js"
			],
			"styles": [
				"gadget.css"
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.notification",
				"mediawiki.util"
			],
			"messages": [
				"embeddablecontent-gadget-copyembed",
				"embeddablecontent-gadget-copycitation",
				"embeddablecontent-gadget-copied",
				"embeddablecontent-gadget-embed-auto",
				"embeddablecontent-gadget-embed-all"
			],
			"targets": [
				"desktop"
			]
		},
		"ext.embeddableContent.sitelinktab": {
			"scripts": [
				"sitelinktab.js"
			],
			"styles": [
				"sitelinktab.css"
			],
			"dependencies": [
				"mediawiki.api",
				"oojs-ui",
				"mediawiki.util"
			],
			"messages": [
				"embeddablecontent-sitelink-tab",
				"embeddablecontent-sitelink-tab-set",
				"embeddablecontent-sitelink-tab-unset",
				"embeddablecontent-sitelink-dialog-title",
				"embeddablecontent-sitelink-placeholder",
				"embeddablecontent-sitelink-link",
				"embeddablecontent-sitelink-cancel",
				"embeddablecontent-sitelink-badid",
				"embeddablecontent-sitelink-error"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.uploadmeta": {
			"scripts": [
				"uploadmeta.js"
			],
			"styles": [
				"uploadmeta.css"
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.notification",
				"oojs-ui"
			],
			"messages": [
				"embeddablecontent-uploadmeta-validate",
				"embeddablecontent-uploadmeta-validating",
				"embeddablecontent-uploadmeta-failed",
				"embeddablecontent-uploadmeta-warning",
				"embeddablecontent-uploadmeta-browserfetch-failed",
				"embeddablecontent-uploadmeta-bytesize",
				"embeddablecontent-entityconfirm-line",
				"embeddablecontent-entityconfirm-yes",
				"embeddablecontent-entityconfirm-no"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.entityconfirm": {
			"scripts": [
				"entityconfirm.js"
			],
			"styles": [
				"uploadmeta.css"
			],
			"dependencies": [
				"oojs-ui"
			],
			"messages": [
				"embeddablecontent-entityconfirm-line",
				"embeddablecontent-entityconfirm-yes",
				"embeddablecontent-entityconfirm-no"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.fileselect": {
			"scripts": [
				"fileselect.js"
			],
			"styles": [
				"uploadmeta.css"
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.util",
				"oojs-ui"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.updatebutton": {
			"scripts": [
				"updatebutton.js"
			],
			"styles": [
				"gadget.css"
			],
			"messages": [
				"embeddablecontent-update-button"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.highlight": {
			"scripts": [
				"highlight/umd-shim.js",
				"highlight/highlight.min.js"
			],
			"styles": [
				"highlight/github.min.css"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.embeddableContent.katex": {
			"scripts": [
				"katex/katex.min.js"
			],
			"styles": [
				"katex/katex.min.css"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "EmbeddableContent/resources"
	},
	"manifest_version": 2,
	"ValidSkinNames": {
		"embedskin": {
			"class": "EmbeddableContent\\Skin\\EmbedSkin"
		}
	}
}
