	"AutoloadNamespaces": {
		"EmbeddableContent\\": "includes/"
	},
	"MessagesDirs": {
		"EmbeddableContent": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"EmbeddableContentMagic": "i18n/EmbeddableContent.i18n.magic.php"
	},
	"config": {
		"EmbeddableContentConfig": {
			"value": [],
			"description": "Instance-specific config map emitted by the seed (issue #6 D2 + issue #7): instanceOf, classes, agentClasses, sourceClasses, payloadProperties, programmingLanguage, describes, implementationOf, note, provenance, externalIds, citationMetadata, formatterUrl, sourceClassByWikidata, agentClassByWikidata, fallbackLanguages, lexers."
		},
		"EmbeddableContentMediaAuthSecret": {
			"value": "",
			"description": "Shared secret used to sign the internal-media cookie (wb_media_auth). Must match the secret in the nginx secure_link_md5 expression. Empty disables the cookie."
		},
		"EmbeddableContentMediaMarkerDirectory": {
			"value": "",
			"description": "Directory holding one marker file per internal-use media file (nginx checks it with stat()). Must be outside the web root and the upload directory."
		},
		"EmbeddableContentInternalFileCategory": {
			"value": "Internal use only files",
			"description": "Category recorded on File: pages of internal-use files (the human-readable marker)."
		}
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
