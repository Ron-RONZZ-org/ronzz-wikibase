{
	"name": "WikibaseCitation",
	"version": "0.2.0",
	"author": [
		"ronzz.org"
	],
	"url": "https://github.com/Ron-RONZZ-org/ronzz-wikibase",
	"descriptionmsg": "wikibasecitation-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"AutoloadNamespaces": {
		"WikibaseCitation\\": "includes/"
	},
	"callback": "WikibaseCitation\\Hooks::onRegistration",
	"MessagesDirs": {
		"WikibaseCitation": [
			"i18n"
		]
	},
	"config": {
		"WikibaseCitationInstanceOf": {
			"value": null,
			"description": "Instance-of property id (e.g. P31). Defaults to EmbeddableContentConfig['instanceOf'] when unset."
		},
		"WikibaseCitationStyleDir": {
			"value": null,
			"description": "Directory with apa.csl / vancouver.csl. Defaults to the extension styles/ dir."
		}
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"APIModules": {
		"citation": {
			"class": "WikibaseCitation\\Api\\ApiCitation",
			"services": [
				"WikibaseCitation.StatementToCslConverter",
				"WikibaseCitation.CitationFormatter",
				"WikibaseRepo.EntityLookup",
				"WikibaseRepo.EntityRevisionLookup",
				"MainObjectStash"
			]
		}
	},
	"manifest_version": 2
}
