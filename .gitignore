# PHP
/vendor/
/extensions/*/vendor/
composer.lock
.phpunit.cache/
.phpunit.result.cache

# Node (citation sidecar — no longer used, kept for history)
/node_modules/
package-lock.json

# Seed output (instance-specific, regenerated by seed_instance.py)
seed/generated/

# MediaWiki extension build artifacts
*.log

# SimpleMathJax MathJax 3 assets — installed by tools/install-mathjax.sh
# (pinned npm tarball, sha256-checked; never committed — see
# extensions/SimpleMathJax/VENDORED.md)
/extensions/SimpleMathJax/resources/MathJax/

# GeoGebra app bundle — installed by tools/install-geogebra.sh
# (pinned official bundle, sha256-checked; never committed — see
# extensions/GeoGebra/ASSETS.md)
/extensions/GeoGebra/resources/player/GeoGebra/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Python
__pycache__/
*.pyc

# Dev stack generated config (WBS /config volume)
dev/config/*
!dev/config/Extensions.php
seed/tests/out/

# opencode worktree plugin (auto-created per environment)
/.opencode/
