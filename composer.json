{
	"name": "ron-ronzz-org/ronzz-wikibase",
	"description": "Wikibase customization for wikibase.ronzz.org — EmbeddableContent and WikibaseCitation extensions, seed tooling, instance documentation",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"data-values/common": "^1.2",
		"data-values/time": "^1.0",
		"phpunit/phpunit": "^10.5",
		"seboettg/citeproc-php": "^2.5",
		"wikibase/data-model": "^9.0",
		"wikibase/data-model-services": "^3.0",
		"wikimedia/objectcache": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"EmbeddableContent\\": "extensions/EmbeddableContent/includes/",
			"WikibaseCitation\\": "extensions/WikibaseCitation/includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true
	}
}
