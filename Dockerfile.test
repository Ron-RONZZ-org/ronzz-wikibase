# Local unit-test image: PHP CLI + intl + composer (citeproc-php needs ext-intl).
# Build once, iterate fast:
#   docker build -f Dockerfile.test -t ronzz-wikibase-test .
#   docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$PWD":/app -w /app ronzz-wikibase-test vendor/bin/phpunit
# (--user keeps bind-mount files owned by you: this image runs as root by
# default and root-owned vendor/.phpunit.cache break git worktree removal.)
FROM composer:2
RUN apk add --no-cache icu-dev \
    && docker-php-ext-install intl \
    && docker-php-ext-enable intl
