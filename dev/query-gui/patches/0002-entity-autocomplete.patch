+		try {
+			path = new URL( url ).pathname;
+		} catch ( e ) {
+			return null;
+		}
+
+		for ( type in entityTypePaths ) {
+			if ( entityTypePaths.hasOwnProperty( type ) ) {
+				patterns = entityTypePaths[type];
+				for ( i = 0; i < patterns.length; i++ ) {
+					if ( path === patterns[i] ) {
+						return type;
+					}
+				}
+			}
+		}
+
+		return null;
+	};
