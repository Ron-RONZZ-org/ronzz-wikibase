+	/**
+	 * Register configured prefixes as entity prefixes (item/property) so the
+	 * editor autocomplete and the hover tooltip search the configured instance
+	 * instead of wikidata.org. The stock ENTITY_TYPES only knows wikidata.org
+	 * URIs; any other instance's prefixes are filtered out by getPrefixMap.
+	 *
+	 * @param {Object} prefixes map of prefix name -> RDF namespace URL
+	 */
+	RdfNamespaces.addEntityTypes = function ( prefixes ) {
+		$.each( prefixes, function ( prefix, url ) {
